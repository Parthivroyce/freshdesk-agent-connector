# Port and Environment
PORT=3000
NODE_ENV=development

# Freshdesk Connector Mode
# When FRESHDESK_API_KEY or FRESHDESK_DOMAIN is omitted, the connector automatically boots into DEMO_MODE=true.
# Set DEMO_MODE=false to enforce strict Live mode with Freshdesk credentials.
DEMO_MODE=true

# Freshdesk REST API Credentials (NEVER commit actual values)
# Example: acme-support.freshdesk.com
FRESHDESK_DOMAIN=your-subdomain.freshdesk.com

# Freshdesk API Key (obtain from Profile Settings -> View API Key)
FRESHDESK_API_KEY=your_freshdesk_api_key_here

# Optional: Override base URL (defaults to https://{FRESHDESK_DOMAIN})
# FRESHDESK_API_BASE_URL=https://your-subdomain.freshdesk.com

# Connector Network & Resilience Parameters
REQUEST_TIMEOUT_MS=10000
MAX_RETRIES=3

# Optional: LLM Summarization (disabled by default; uses deterministic engine when unset)
ENABLE_LLM_SUMMARY=false
# GEMINI_API_KEY=your_gemini_api_key_here

# Applet Hosting (injected in AI Studio Cloud Run)
APP_URL=http://localhost:3000

